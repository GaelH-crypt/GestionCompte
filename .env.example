# Database
POSTGRES_DB=gestioncompte
POSTGRES_USER=gestioncompte
POSTGRES_PASSWORD=changeme_strong_password
# DATABASE_URL is assembled automatically by docker-compose — do not set it here

# Django
SECRET_KEY=changeme_very_long_random_secret_key_at_least_50_chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost

# Redis (cache partagé pour le rate limiting multi-workers)
REDIS_URL=redis://redis:6379/0

# Admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@gestioncompte.local
DJANGO_SUPERUSER_PASSWORD=changeme_admin_password

# GoCardless Bank Account Data (https://bankaccountdata.gocardless.com)
# Create a free account at https://ob.gocardless.com/sign-up
GOCARDLESS_SECRET_ID=your_secret_id_here
GOCARDLESS_SECRET_KEY=your_secret_key_here
# URL where GoCardless redirects after bank authentication (must match your domain)
GOCARDLESS_REDIRECT_URI=http://localhost/bank-sync/callback
